# Copy this file to .env and fill in the key(s) for the provider(s) you use, then:
#   set -a; source .env; set +a
# .env is gitignored. Never commit real keys.

# Anthropic (Claude) — used by: iso8583lens generate --provider claude
ANTHROPIC_API_KEY=

# OpenAI — used by: iso8583lens generate --provider openai
OPENAI_API_KEY=

# Optional model overrides (defaults are the cheapest capable model per provider).
# ISO8583_CLAUDE_MODEL=claude-haiku-4-5
# ISO8583_OPENAI_MODEL=gpt-4o-mini
